---
import AlderPopup from "../components/AlderPopup.astro";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import IndexCard from "../components/IndexCard.astro";
import OmOs from "../components/OmOs.astro";
import Nyhedsbrev from "../components/Nyhedsbrev.astro";
import IndexCards2 from "../components/IndexCards2.astro";
import Values from "../components/Values.astro";
---

<Layout>
  <AlderPopup />
  <Hero
    title="LESS WASTE GREAT TASTE"
    subtitle="Køb billige specialøl 
	med både korte og lange holdbarhedsdatoer"
  />
  <Values />
  <IndexCard />
  <OmOs />
  <Nyhedsbrev />
<IndexCards2/>

</Layout>

<style>
  body {
    background-color: var(--white);
  }
</style>
