---
//@ts-nocheck
import Layout from '../../layouts/Layout.astro';
import IndexCard from "../../components/IndexCard.astro";
export async function getStaticPaths() {
    const endpoint = "https://iqemsajivxgkyvnsblsh.supabase.co/rest/v1/beer?select=*";
    const key = "sb_publishable_JJminKHUu5Xa_j_oVoNy_Q_djiIwRvF";
    
    const response = await fetch(endpoint, { headers: { apikey: key } });
    const products = await response.json();

    return products.map((product) => ({
        
        params: { slug: product.id.toString() }, 
        props: { product },
    }));
}

const { product } = Astro.props;

---

<Layout title={product.title}>
  <main>
    <section class="product_detail">
        <img src={product.image} alt={product.title} />
        <div>
            <h5>{product.brand}</h5>
            <h2>{product.title}</h2>
            <p class="type">{product.type}</p>
            <p class="description">{product.description}</p>
            <p class="price">{product.price} kr</p>
            </div>
    </section>

<section class="IndexCard-bg">
    <h2>Anbefalet til dig</h2>
 <IndexCard />
 </section>

  </main>
</Layout>

<style>


.IndexCard-bg h2{
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    color: var(--darkest_green);
    font-weight: 600;
    font-size: 40px ;
    padding-top: 3rem ;


}
.IndexCard-bg{
    background-color: var(--off_white);
}
    .product_detail {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        padding: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }
    img {
        max-width: 100%;
        height: auto;
    }
    /* Tilføj mere styling her efter behov */
</style>