<style>
    main {
        background-color: var(--white);
    }
    .IndexCard-bg h2{
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    color: var(--darkest_green);
    font-weight: 600;
    font-size: 40px ;
    padding-top: 3rem ;
    }
    .IndexCard-bg{
    background-color: var(--off_white);
    }
    .product_grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        padding: 2rem;
        max-width: 1200px;
        margin: 0 auto;
        color: var(--darkest_green);
    }

    .gallery {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.main-img-container img {
    width: 100%;
    max-height: 500px;
    object-fit: contain;
    transition: opacity 0.3s ease; /* Blød overgang når der skiftes */
}

.thumbnails {
    display: flex;
    gap: 10px;
    justify-content: center;
}

.thumb {
    width: 80px;
    height: 80px;
    object-fit: contain;
    border: 2px solid transparent;
    cursor: pointer;
    padding: 5px;
    border-radius: 8px;
}

.thumb:hover {
    border-color: var(--grey);
}


      .breadcrumb {
        color: var(--grey);
        text-transform: uppercase;
    }
    
    .breadcrumb a {
        color: var(--grey);
        text-decoration: none;
        text-transform: uppercase;
    }

    .best-before {
        color: var(--dark_yellow);
        text-decoration: underline;
        font-size: 1.2rem;
    }

    .purchase-options {
  display: flex;
  gap: 20px;
  padding: 20px;
}

.option-card {
  border: 1px solid var(--grey);    
  border-radius: 12px;      
  padding: 24px;
  flex: 1;
  max-width: 300px;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 10px;
}

.card-header h3 {
  font-size: 24px;
  margin: 0;
  color: var(--darkest_green);
}

.icon {
  max-height: 40px;
  height: auto;
}

.stock {
  color: var(--dark_yellow);
  margin: 5px 0;
}

.price-stk {
  font-size: 18px;
  margin: 10px 0 0 0;
}

.price-total {
  color: var(--grey);
  font-size: 14px;
  margin-top: 2px;
}

.quantity-selector {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-top: 20px;
}

.quantity-selector button {
  background: none;
  border: 1.5px solid var(--grey);
  border-radius: 50%;
  width: 30px;
  height: 30px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
}

.quantity-selector span {
  font-size: 22px;
  font-weight: 500;
}

</style>

<script>
    const mainImg = document.getElementById('main-img');
    const thumbs = document.querySelectorAll('.thumb');

    thumbs.forEach(thumb => {
        thumb.addEventListener('click', () => {
            const newSrc = thumb.getAttribute('data-full');
            // Vi fortæller TypeScript at mainImg er et billede (HTMLImageElement)
            if (mainImg instanceof HTMLImageElement && newSrc) {
                mainImg.src = newSrc;
            }

            thumbs.forEach(t => t.classList.remove('active'));
            thumb.classList.add('active');
        });
    });

    const selectors = document.querySelectorAll('.quantity-selector');

    selectors.forEach(selector => {
        const minusBtn = selector.querySelector('button:first-child');
        const plusBtn = selector.querySelector('button:last-child');
        const countSpan = selector.querySelector('span');

        let count = 0;

        if (plusBtn && minusBtn && countSpan) {
            plusBtn.addEventListener('click', () => {
                if (count < 10) {
                    count++;
                    countSpan.textContent = count.toString();
                }
            });

            minusBtn.addEventListener('click', () => {
                if (count > 0) {
                    count--;
                    countSpan.textContent = count.toString();
                }
            });
        }
    });
</script>