
---
//@ts-nocheck
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro'; // Vi importerer dit Card

const endpoint = "https://iqemsajivxgkyvnsblsh.supabase.co/rest/v1/beer?select=*";
const key = "sb_publishable_JJminKHUu5Xa_j_oVoNy_Q_djiIwRvF";

const res = await fetch(endpoint, { headers: { apikey: key } });
const products = await res.json();
---

<Layout title="Vores Øludvalg">
  <section class="grid">
    {products.map(item => (
      <Card data={item} /> 
    ))}
  </section>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
  }
</style>