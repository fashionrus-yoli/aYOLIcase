---
import Card from "../components/Card.astro";
const endpoint = "https://iqemsajivxgkyvnsblsh.supabase.co/rest/v1/beer?select=*&limit=4";
const key = "sb_publishable_JJminKHUu5Xa_j_oVoNy_Q_djiIwRvF";

const options = {
    method:"GET",
    headers: {
        apikey: key,
    },
};

const data = await fetch(endpoint, options).then((response) => response.json());
console.log(data);

---




<article class="index-card-grid">
{data.map((beer: any) => (
  <Card data={beer} />
))}
</article>


<style>

  .index-card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding-top: 3rem;
    padding-bottom: 7rem;
  }
  
  @media screen and (min-width: 1000px) {
  .index-card-grid {
    display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin: 4rem;
  padding-bottom: 10rem;
  }}




</style>