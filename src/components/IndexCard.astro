---
import Card from "../components/Card.astro";
const endpoint = "https://iqemsajivxgkyvnsblsh.supabase.co/rest/v1/beer?select=*&limit=4";
const key = "sb_publishable_JJminKHUu5Xa_j_oVoNy_Q_djiIwRvF";

const options = {
    method:"GET",
    headers: {
        apikey: key,
    },
};

const data = await fetch(endpoint, options).then((response) => response.json());
console.log(data);

---

 <div class="card-nav">
  <a href="" >Udvalgte øl</a>
  <a href="">Nye fund</a>
  <a href="">Kort dato</a>
</div>


<article class="index-card-grid">
{data.map((beer: any) => (
  <Card data={beer} />
))}
</article>


<style>

.index-card-grid {
    display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin: 4rem;
  }

  @media (max-width: 800px) {
  .index-card-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
.card-nav {
margin: 4rem;
  display: flex;
  justify-content: center;
  gap: 3rem;
  margin-bottom: 3rem;
  padding-top: 3rem;
}

.card-nav a {
  text-decoration: none;
color: var(--darkest_green);
  font-size: 1.5rem;
  font-family: var(--inter);
  position: relative;
  padding-bottom: 5px;
}

/* underline effect */
.card-nav a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 0%;
  height: 2px;
background-color: var(--darkest_green);
  transition: 0.3s ease;
}

.card-nav a:hover::after {
  width: 100%;
}
</style>