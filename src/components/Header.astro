<style>
    /* put this in general */
    body{
        font-family: var(--inter);
        color: var(--darkest_green) ;
        font-size: 14px;
    }
    a{
        text-decoration: none;
        color: var(--darkest_green) ;
    }

    ul li a {
        position: relative;
    }

    ul li a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -5px;
        width: 100%;
        height: 2px;
        background: var(--darkest_green);
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.3s ease;
        z-index: 1000;
    }

    ul li a:hover::after {
        transform: scaleX(1);
    }

    .nav{
        display: flex;
        /* change color */
        background-color: #EBEBD0;
        justify-content: space-between;
        align-items: center;
        padding: 0 3rem;
        height: 80px;
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    .menu {
        display: flex;
        justify-content: space-evenly;
        align-items: center;
        width: 100%;
        list-style: none;
    }

    .menu li {
        position: relative;
    }

    .submenu {
        position: absolute;
        top: 100%;
        left: 0;
        /* change color */
        background: #EBEBD0;
        list-style: none;
        padding: 2rem;
        border-radius: 7px;
        width: 200px;
        line-height: 2.5rem;

        /* animation */
        opacity: 0;
        transform: translateY(-10px);
        pointer-events: none;

        transition: all 0.2s ease;
    }

    .dropdown:hover > .submenu {
        /* animation */
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    .submenu .submenu {
        top: 0;
        left: 100%;
        padding: 2rem 2rem 2rem 4rem;
    }

    .nav-icons{
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 150px;
    }

    .search, .profile, .bag {
        cursor: pointer;
    }


</style>