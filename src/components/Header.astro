<style>
    /* put this in general */
    body{
        font-family: helvetica neue;
    }
    a{
        text-decoration: none;
    }

    .arrow-add{
        display: flex;
        align-items: center;
        gap: 0 0.5rem;
        height: 100%;
    }

    .nav{
        display: flex;
        /* change color */
        background-color: #EBEBD0;
        justify-content: space-between;
        align-items: center;
        padding: 0 3rem;
    }

    .menu {
        display: flex;
        justify-content: space-evenly;
        width: 100%;
        list-style: none;
    }

    .menu li {
        position: relative;
    }

    .submenu {
        position: absolute;
        top: 100%;
        left: 0;
        /* change color */
        background: #EBEBD0;
        list-style: none;
        padding: 2rem;
        border-radius: 7px;
        width: 220px;

        /* animation */
        opacity: 0;
        transform: translateY(-10px);
        pointer-events: none;

        transition: all 0.2s ease;
    }

    .dropdown:hover > .submenu {
        /* animation */
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }
/* 
    .submenu li{
        padding: 0.5rem;
    } */

    .submenu .submenu {
        top: 0;
        left: 100%;
        padding: 2rem 2rem 2rem 4rem;
    }

    .nav-icons{
        display: flex;
        justify-content: space-between;
        width: 160px;
    }
</style>