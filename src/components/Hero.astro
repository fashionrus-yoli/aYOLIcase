---
const {title, subtitle} = Astro.props;

---

<article class="hero">
  <div class="hero-indhold">
     <h1>{title}</h1>
    <div class="hero-tekst">
      <p>{subtitle}</p>
      <a class="hero-knap" href="list">Se udvalg</a>
    </div>
  </div>
</article>



<style>
  .hero {
    background-image: url("/src/assets/humle.webp");
    background-size: cover;
    background-position: center;
    padding: 4rem 1.5rem;
}

/* SIMPEL STACK */
.hero-indhold {
    display: flex;
    flex-direction: column;
}

/* H1 */
.hero-indhold h1 {
    font-size: 35px;
    font-family: var(--h1);
    color: #EBEBD0;
    line-height: 1.2;
    max-width: 400px;
    text-shadow: 2px 2px 8px rgba(0,0,0,0.4);
}

/* TEKST */
.hero-tekst {
    margin-top: 1rem;
    font-family: var(--inter);
    color: var(--white);
    font-size: 1.2rem;
    max-width: 250px;
}

/* KNAP */
.hero-knap {
    display: inline-block;
    
    padding: 0.8rem 0.8rem;

    background-color: #2f3e2c;
    color: #FFFBF2;

    text-decoration: none;
    border-radius: 7px;
}


@media screen and (min-width: 1000px) {
.hero{
    background-image:url("/src/assets/humle.webp");
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    height: 85vh;
    }

.hero-indhold{
    display: grid;
    grid-template-rows: 1fr 1fr 1fr;
}

.hero-indhold h1{
    font-size: 110px;
    font-family: var(--h1);
    color: #EBEBD0;
    padding-left: 5rem;
    grid-row: 1/-2;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.4);
    line-height: 120%;
    max-width: 950px;
}

.hero-tekst{
    color: var(--white);
    font-family: var(--inter);
    padding-left: 5rem;
    font-size: 2rem;
    max-width: 350px;
    grid-row: 3;
}

.hero-knap{
    margin-top: 1.5rem;
    padding: 1rem 1rem;
    background-color: #2f3e2c;
    color: #FFFBF2;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    border-radius: 7px;
    transition: 0.2s ease;
}
.hero-knap:hover {
    background-color: #d1a95f;
    transform: translateY(-2px);
}}

</style>
