---
import mitIdIconBlue from "../assets/MitID_Blue.svg";
import mitIdIconWhite from "../assets/MitID_White.svg";

const {
  title = "MitID Alderskontrol",
  message = "Ny dansk lovgivning kræver MitID aldersverificering ved onlinekøb af alkohol og tobak.",
  footnote = "*Du vil blive viderestillet til betaling efter verificering",
  redirectUrl = "/checkoutflow", // udskift når siden er oprettet
  triggerId = "open-mitid-popup", // brug som id på den fremtidige knap
} = Astro.props;
---

<div id="mitid-popup-overlay" class="overlay" hidden>
  <div
    class="popup"
    role="dialog"
    aria-modal="true"
    aria-labelledby="popup-title"
    aria-describedby="popup-message"
  >
    <div class="popup-content">
      <h1 id="popup-title" class="popup-title">{title}</h1>
      <h2 id="popup-message" class="popup-message">{message}</h2>
    </div>

    <div id="popup-actions" class="popup-actions">
      <button id="popup-verify" class="btn btn-primary" type="button">
        <span>Bekræft med</span>
        <img
          src={mitIdIconWhite.src}
          alt=""
          class="btn-icon icon-default"
          aria-hidden="true"
        />
        <img
          src={mitIdIconBlue.src}
          alt=""
          class="btn-icon icon-hover"
          aria-hidden="true"
        />
      </button>
    </div>
    <div class="popup-content">
      <p id="popup-footnote" class="popup-footnote">{footnote}</p>
    </div>
  </div>
</div>

<script
  define:vars={{
    title,
    message,
    footnote,
    redirectUrl,
    triggerId,
  }}
>
  const overlay = document.getElementById("mitid-popup-overlay");
  const titleEl = document.getElementById("popup-title");
  const messageEl = document.getElementById("popup-message");
  const footnoteEl = document.getElementById("popup-footnote");
  const verifyBtn = document.getElementById("popup-verify");

  function openPopup() {
    overlay?.removeAttribute("hidden");
    document.body.classList.add("popup-open");
  }

  function closePopup() {
    if (!overlay) return;

    overlay.classList.add("is-closing");
    document.body.classList.remove("popup-open");

    setTimeout(() => {
      overlay.setAttribute("hidden", "");
      overlay.classList.remove("is-closing");
    }, 350);
  }

  function showInitialState() {
    if (titleEl) titleEl.textContent = title;
    if (messageEl) messageEl.textContent = message;
    if (footnoteEl) footnoteEl.textContent = footnote;
  }

  // Når knappen til åbning af popup bliver lavet senere, skal den have id="open-mitid-popup"
  function bindTriggerButton() {
    window.addEventListener("DOMContentLoaded", () => {
      const triggerBtn = document.getElementById(triggerId);

      if (!triggerBtn) {
        console.warn(
          `[MitIdPopUp] Ingen trigger-knap fundet med id="${triggerId}".`,
        );
        return;
      }

      triggerBtn.addEventListener("click", () => {
        openPopup();
      });
    });
  }

  bindTriggerButton();

  verifyBtn?.addEventListener("click", () => {
    closePopup();

    setTimeout(() => {
      window.location.href = redirectUrl;
    }, 350);
  });
</script>

<style>
  :global(body.popup-open) {
    overflow: hidden;
  }

  .overlay {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: rgba(0, 0, 0, 0.55);
    z-index: 9999;
  }

  .overlay[hidden] {
    display: none !important;
  }

  .overlay.is-closing {
    opacity: 0;
    transition: 0.3s;
    pointer-events: none;
  }

  .popup {
    width: min(100%, 15Srem);
    min-height: 15rem;
    border-radius: 12px;
    background-image: url(src/assets/mitidbaggrund.svg);
    background-repeat: no-repeat;
    background-size: cover;
    padding: 2rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    text-align: center;
  }

  .popup-content {
    display: grid;
    gap: 0.5rem;
  }

  .popup-title {
    color: #183555;
    padding-top: 2.5rem;
    margin: 0;
    font-size: 1.25rem;
    font-weight: 900;
  }

  .popup-message {
    color: #183555;
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .popup-footnote {
    color: rgb(24, 53, 85, 0.5);
    margin: 0;
    font-size: 0.8rem;
    padding-top: 1rem;
  }

  .popup-actions {
    display: flex;
    justify-content: center;
    margin-top: 1.25rem;
  }

  .btn {
    width: fit-content;
    border: 0;
    border-radius: 7px;
    padding: 0.75rem 0.5rem;
    font: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .btn-icon {
    width: 3rem;
    height: auto;
    display: block;
  }
  .icon-hover {
    display: none;
  }

  .btn-primary {
    box-sizing: border-box;
    background: #2278d4;
    border: 2px solid #2278d4;
    color: #eef7ff;
    font-weight: 900;
    transition: 0.3s;
  }
  .btn:hover .icon-default {
    display: none;
    transition: 0.3s;
  }

  .btn:hover .icon-hover {
    display: block;
    transition: 0.3s;
  }

  .btn-primary:hover {
    color: #2278d4;
    background: #eef7ff;
    border: 2px solid #2278d4;
  }

  @media (min-width: 800px) {
    .popup {
      width: min(100%, 20rem);
      height: 15rem;
      padding: 2rem;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    }
    .popup-content {
      gap: 0.5rem;
    }

    .popup-title {
      padding-top: 3rem;
      font-size: 1.75rem;
    }

    .popup-message {
      padding-top: 0.75rem;
      font-size: 1rem;
    }

    .popup-footnote {
      padding-top: 0.5rem;
      font-size: 0.75rem;
    }
  }
</style>
