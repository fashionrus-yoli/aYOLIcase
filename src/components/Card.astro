---
const {product} = Astro.props;
import '../../public/css/variabler.css'
import Button from '../components/Button.astro';
---

<a href={`/produkter/${product.id}`}>
<article>
    <div class="image_container">
        <img src={product.image}>
        <div class="badge_container">
      {product.short_date && <span class="badge orange">Kort dato</span>}
      {product.limited && <span class="badge grey">Begrænset antal</span>}
      {product.new && <span class="badge green">Nyhed</span>}
    </div>
  </div>

        <section class="card_description">
            <div class="text_top">
       <h5>{product.brand}</h5>
        <h3>{product.title}</h3>
        <p>{product.type}</p>
       </div>

        <div class="price_section">
        <h4>{product.price} kr</h4>
        {product.before_price && <h4 class="overstreget">{product.before_price} kr.</h4>}
        </div>
        <Button  size="large" />
        </section>
        
</article>

<style>
        article {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 1rem;
}

img {
 max-width: 100%;
}

.image_container {
  position: relative;
  display: flex;
  justify-content: center;
  padding: 20px;
}

.badge_container {
  position: absolute;
  top: 10px;
  left: 10px;
  display: flex;
  flex-direction: column;
  align-items: flex-start; 
  gap: 5px;
}

.badge {
    font-family: var(--inter);
    font-weight: 500;
  width: fit-content; 
  padding: 4px 8px;
  border-radius: 4px;
  color: white;
  white-space: nowrap;
}

.orange { background-color: var(--dark_yellow); }
.grey { background-color: var(--grey); }
.green { background-color: var(--light_green); } 

h2, h3, h4, h5, p {
 font-family: var(--inter);
  color: var(--text);
 font-weight: 500;
}

h3, h5 {
    text-transform: uppercase;
}

h3 {
    font-size: 2rem;
}

h4, h5 {
    font-size: 1.5rem;
}

p {
  opacity: 0.5;  
}

.overstreget {
    opacity: 0.5;
    text-decoration-line: line-through;
    font-size: 1.2rem;
}

.card_description {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  flex-grow: 1
}


.price_section {
   display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: auto;
}

a {
  text-decoration: none;
}

@media (max-width: 450px) {

  article {
    padding: 0.5rem; /* Mindre luft i kanten */
  }

  h3 {
    font-size: 1.3rem; /* Gør titlen mindre på mobilen */
  }

  h4, h5 {
    font-size: 1rem; /* Gør brand og pris mindre */
  }

  p{
    font-size: 0.8rem;
  }

  .badge {
    font-size: 0.6rem;
    padding: 2px 6px;
  }

.card_description {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  gap: 0.5rem; 
}

.text_top {
  margin-bottom: 1rem; 
}

.price_section {
  margin-top: auto; 
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-top: 0.5rem; 
}

button {
  width: 100%;
  margin-top: 0.5rem;
}

}


</style>
</a>