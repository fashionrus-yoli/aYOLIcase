---
import "../../public/css/variabler.css";

const {
  title = "Hold dig opdateret på nyheder og begivenheder",
  placeholder = "Indtast din e-mail",
} = Astro.props;
---

<article class="form-sektion">
  <div class="form">
    <h1>{title}</h1>

    <form class="input-btn">
      <input type="email" placeholder={placeholder} />
      <button type="submit">Indsend</button>
    </form>
  </div>
</article>

<style>
  .form-sektion {
    background-image: url("../../src/assets/formbaggrund.svg");
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    min-height: 330px;
    display: grid;
    place-items: center;
    padding: 2rem 1rem;
  }

  .form {
    width: 100%;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .form h1 {
    margin: 0;
    text-align: center;
    color: var(--darkest_green);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .input-btn {
    width: 100%;
    height: 48px;
    display: flex;
  }

  .input-btn input,
  .input-btn button {
    height: 100%;
    box-sizing: border-box;
    margin: 0;
    font: inherit;
    font-size: 0.95rem;
  }

  .input-btn input {
    flex: 1;
    min-width: 0;
    padding: 0 16px;
    border: 2px solid var(--darkest_green);
    border-right: none;
    border-radius: 8px 0 0 8px;
    background-color: #d9d9c6;
    color: var(--darkest_green);
    outline: none;
  }

  .input-btn button {
    padding: 0 16px;
    border: 2px solid var(--darkest_green);
    border-radius: 0 8px 8px 0;
    background-color: var(--darkest_green);
    color: var(--white);
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    appearance: none;
    -webkit-appearance: none;
    transition: 0.3s;
  }

  .input-btn button:hover {
    background-color: var(--dark_yellow);
    color: var(--darkest_green);
  }

  @media (min-width: 800px) {
    .form {
      gap: 2rem;
    }

    .form h1 {
      font-size: 1.8rem;
    }

    .input-btn {
      height: 56px;
    }

    .input-btn input {
      padding: 0 28px;
    }

    .input-btn button {
      padding: 0 34px;
      font-size: 1rem;
    }
  }
</style>
