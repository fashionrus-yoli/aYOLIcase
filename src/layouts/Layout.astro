---
import Header from "../components/Header.astro";
import TopBanner from "../components/TopBanner.astro";
import Footer from "../components/Footer.astro";
---

<html lang="da">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Rammetto+One&display=swap" rel="stylesheet">
		<title>A Good Case</title>
		<style is:global>
			@import url('https://fonts.googleapis.com/css2?family=Rammetto+One&display=swap');
		</style>
	</head>
	<body>
		<header>
			<TopBanner/>
			<Header/>
		</header>
		<slot />
		<Footer/>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
